config_version=5

[addons]

ss2d/version="3.3.1"

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Poopy the Game"
run/main_scene="uid://dady2wku1xusy"
config/features=PackedStringArray("4.7", "Mobile")
run/max_fps=60
config/icon="uid://0e8y4uioqvmy"

[audio]

buses/default_bus_layout="uid://b83hcldu70xad"
general/default_playback_type.web=0

[autoload]

Global="*res://scripts/global.gd"
UserSettingsInstance="*uid://dvb22fhd6b76y"
AudioManager="uid://bj6gqlll6sgrr"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="experimental hodge podge"

[editor_plugins]

enabled=PackedStringArray("res://addons/rider-plugin/plugin.cfg", "res://addons/rmsmartshape/plugin.cfg")

[global_group]

