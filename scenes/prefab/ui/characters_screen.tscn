[sub_resource type="Resource" id="Resource_5dct7"]
script = ExtResource("5_vp7t4")
bio = "The main guy from the game. Despite always being silent, Poopy makes a racket everywhere he goes with his action. He’s a lil goober most of the time, but he turns into a bloodthirsty maniac the moment anyone ticks him. In his latest adventure, he goes to stop John Person’s evil scheme of reselling his pet chicken, the Cock."
title = "Poopy the Game"
portrait = ExtResource("4_gsfsb")
metadata/_custom_type_script = "uid://8kv681icjouq"

