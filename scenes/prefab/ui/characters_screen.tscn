[sub_resource type="Resource" id="Resource_1mexh"]
script = ExtResource("5_vp7t4")
bio = "An awesome animatronic band in Person Industry’s subsidiary restaurant, Pop-I’s pizza showtime. People always assume they are creepy possessed killer robots because of their uncanny appearances, but in reality, they just want a pal to sing with."
